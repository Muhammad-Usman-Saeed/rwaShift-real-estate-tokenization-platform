# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs — keep the broadcast directory itself (real testnet/mainnet
# transaction history is worth committing), just not local Anvil (chain id 31337) runs or dry-runs.
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Local Anvil deployment record — regenerated with fresh addresses on every `docker compose up
# --build` (see docker-compose.yml's contracts-deploy service), never meaningful to diff/commit.
# A future real deployment record (e.g. deployments/sepolia.json) would be worth committing.
/deployments/local.json

# Dotenv file
.env
.env.*
!.env.example
