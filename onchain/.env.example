# Copy to .env and fill in real values. Never commit .env.
# .env is already git-ignored (see .gitignore).

# Sepolia RPC endpoint (Alchemy/Infura/etc.)
SEPOLIA_RPC_URL=

# Private key of the account that broadcasts DeploySepolia.s.sol. Must be funded with Sepolia ETH.
# Use a dedicated deployer key, never a key that also holds mainnet funds.
DEPLOYER_PRIVATE_KEY=

# Optional: address that should receive PLATFORM_ADMIN control. Defaults to the deployer address
# derived from DEPLOYER_PRIVATE_KEY if omitted.
PLATFORM_ADMIN=

# Etherscan API key, used by `forge script --verify`.
ETHERSCAN_API_KEY=

# Optional override for local Anvil deployment/seed scripts. Defaults to Anvil's well-known
# account #0 key if omitted (safe: local-only, never used on a real network).
LOCAL_DEPLOYER_KEY=
