# ---- Auth.js / OIDC (Spring Authorization Server) ----
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
# Browser-reachable issuer — the offchain app serves both the API and the Authorization Server
# on the same port (8080), there is no separate :9000 auth server. Must exactly match
# offchain's OAUTH2_ISSUER_URI (see offchain/src/main/resources/application.yml).
AUTH_ISSUER=http://localhost:8080
AUTH_CLIENT_ID=rwashift-web
AUTH_CLIENT_SECRET=rwashift-web-secret
# Only needed when running the frontend in Docker Compose against a backend in another
# container: Auth.js's server-side token/userinfo/jwks calls happen from inside the frontend
# container, which can't resolve "localhost" as the backend — see docker-compose.yml at the
# repo root, which sets this to the backend's container network address (http://app:8080).
AUTH_INTERNAL_ISSUER=

# ---- Spring Boot REST API ----
# Server-side (route handlers, server components) base URL for the offchain API.
API_BASE_URL=http://localhost:8080/api/v1
# Public base URL exposed to the browser (kept identical unless the API is behind a
# different public host than the server-side network path, e.g. in Docker Compose).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# ---- Blockchain (read-only, for explorer links / wallet network config) ----
NEXT_PUBLIC_CHAIN=sepolia
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Observability ----
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
NEXT_PUBLIC_OTEL_SERVICE_NAME=rwashift-frontend
