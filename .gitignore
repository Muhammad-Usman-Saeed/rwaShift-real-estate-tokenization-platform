# This repo is a multi-project monorepo (frontend/, offchain/, onchain/) — each sub-project owns
# its own .gitignore for its own toolchain (node_modules, target/, cache/, etc.). Keep this root
# file to genuinely cross-cutting/root-level concerns only.

# Environment
.env
.env.*
!.env.example

# IDE / editor
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
.internal/
.claude/