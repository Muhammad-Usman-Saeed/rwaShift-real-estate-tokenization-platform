[submodule "onchain/lib/forge-std"]
	path = onchain/lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "onchain/lib/openzeppelin-contracts"]
	path = onchain/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "onchain/lib/openzeppelin-contracts-upgradeable"]
	path = onchain/lib/openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
[submodule "onchain/lib/T-REX"]
	path = onchain/lib/T-REX
	url = https://github.com/ERC-3643/ERC-3643
[submodule "onchain/lib/solidity"]
	path = onchain/lib/solidity
	url = https://github.com/onchain-id/solidity
