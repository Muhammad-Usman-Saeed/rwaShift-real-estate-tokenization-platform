# Overrides for the root docker-compose.yml. Copy to `.env` in this same directory to customize
# — Docker Compose loads it automatically. None of these need to be set for a first run; every
# service has a local-dev-safe default baked into docker-compose.yml itself.

# Auth.js session-encryption secret for the frontend container. Generate a real one with:
#   openssl rand -base64 32
AUTH_SECRET=local-dev-only-secret-change-me

# Anvil's well-known default account #0 — used both as the on-chain deployer (contracts-deploy)
# and the platform's own on-chain agent wallet, which only ever creates new (empty) offering token
# suites — see onchain/src/core/RwaShiftTokenFactory.sol's ISSUER_ADMIN_ROLE docs. Never a real key.
BLOCKCHAIN_AGENT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# AES-256 master key (base64) encrypting each organization's own on-chain wallet at rest — see
# OrganizationWalletEncryptionService. Generate a real one with: openssl rand -base64 32
ORG_WALLET_MASTER_KEY=2SdLQlXkonyIAydL6CTeheLs1rR7/Najn8ty4QScurQ=

# Seeds the canonical demo scenario (ABC Real Estate / Dubai Business Tower) on first boot.
# Set to false if you'd rather build up state manually through the UI.
RWASHIFT_SEED_ENABLED=true
